# Copy to .env and adjust. Never commit .env.

# ---- Database (docker compose builds DATABASE_URL from these) ----
POSTGRES_USER=policyqa
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=policyqa
# Only for running the API outside docker compose:
# DATABASE_URL=postgresql://policyqa:change-me@localhost:5432/policyqa
# VECTOR_STORE=postgres              # or "memory" for a database-free demo (data is lost on restart)

# ---- Language model ----
# extractive = no LLM; answers are verbatim, cited policy sentences (deterministic, free, used in CI)
LLM_PROVIDER=extractive
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai                # also works with OpenAI-compatible servers (Ollama, vLLM) via LLM_BASE_URL
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# ---- Embeddings ----
# hashing = deterministic lexical baseline, no download or API key. openai = semantic embeddings (recommended).
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=1024
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# Changing the embedder requires re-indexing: policyqa reset-db --yes && policyqa ingest data/policies

# ---- API security ----
# When set, uploads and deletes require the X-API-Key header. Generate with: openssl rand -hex 24
API_KEY=
REQUIRE_API_KEY_FOR_ASK=false
ALLOW_UPLOADS=true
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=300
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ---- Retrieval / agent tuning ----
RETRIEVAL_TOP_K=6
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
MIN_TERM_COVERAGE=0.5

# ---- Logging ----
LOG_LEVEL=INFO
LOG_QUESTIONS=false                  # questions can contain personal data; off by default
